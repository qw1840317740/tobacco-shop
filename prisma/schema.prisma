generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String   @id
  slug        String   @unique
  name        String
  nameJa      String
  nameZh      String
  description String   @default("")
  image       String   @default("")
  count       Int      @default(0)
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id           String   @id
  slug         String   @unique
  code         String   @default("")
  name         String
  nameZh       String   @default("")
  price        Decimal  @db.Decimal(10, 2)
  image        String   @default("")
  type         String   @default("CIGARETTE")
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  region       String   @default("Japan")
  inStock      Boolean  @default(true)
  featured     Boolean  @default(false)
  desc         String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categoryId])
}

model Admin {
  id           String   @id
  username     String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model User {
  id                String    @id
  email             String    @unique
  passwordHash      String
  name              String
  phone             String    @default("")
  birthdate         DateTime?
  ageVerified       Boolean   @default(false)
  ageDocStatus      String    @default("none")
  ageDocUrl         String    @default("")
  ageDocType        String    @default("")
  ageDocReviewedAt  DateTime?
  ageDocReviewedBy  String?
  ageDocRejectReason String   @default("")
  role              String    @default("customer")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  addresses         Address[]
  orders            Order[]

  @@index([email])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   @default("home")
  name        String
  phone       String   @default("")
  postalCode  String
  address1    String
  address2    String   @default("")
  city        String   @default("")
  prefecture  String   @default("")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Order {
  id              String   @id
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String   @default("pending")
  items           Json
  subtotal        Decimal  @db.Decimal(10, 2)
  shippingFee     Decimal  @db.Decimal(10, 2)
  tax             Decimal  @db.Decimal(10, 2)
  total           Decimal  @db.Decimal(10, 2)
  shippingName    String
  shippingPhone   String   @default("")
  shippingPostalCode String @default("")
  shippingAddress String
  paymentMethod   String   @default("bank_transfer")
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}
